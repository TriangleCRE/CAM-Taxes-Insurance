# Copy to .env.local for local development. On Vercel, DATABASE_URL / POSTGRES_URL
# are already provided by the Neon Postgres storage integration - don't set them
# in the dashboard by hand, and never commit real values here.
DATABASE_URL=postgres://user:password@localhost:5432/camtest

# Passcode required to view the site (set as a Vercel env var in production -
# never commit the real value here). Pick anything for local dev.
PASSCODE=changeme
